#include <stdio.h>

int main()
{
    int n, i, sum = 0, res = 1;

    printf("===== LOOPING STATEMENTS =====\n");

    printf("Enter a number: ");
    scanf("%d", &n);

    // For loop
    printf("\nNumbers from 1 to %d:\n", n);

    for (i = 1; i <= n; i++)
    {
        printf("%d ", i);
    }

    // While loop
    i = 1;

    while (i <= n)
    {
        sum = sum + i;
        i++;
    }

    // Do-while loop
    i = 1;

    do
    {
        res = res * i;
        i++;
    }
    while (i <= n);

    printf("\n\nSum of numbers = %d", sum);
    printf("\nFactorial of %d = %d\n", n, res);

    return 0;
}
